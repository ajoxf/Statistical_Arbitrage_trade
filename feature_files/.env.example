# StatArb Pro Environment Configuration
# Copy this file to .env and fill in your credentials

# ===========================================
# OKX Exchange Configuration
# ===========================================
# Get API credentials from: OKX > Settings > API > Create API Key
# Required permissions: Read, Trade

OKX_API_KEY=your_api_key_here
OKX_API_SECRET=your_api_secret_here
OKX_PASSPHRASE=your_passphrase_here

# Trading mode: true = demo/paper trading, false = live trading
OKX_SIMULATED=true

# ===========================================
# MT5 Configuration (Optional)
# ===========================================
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_ACCOUNT=12345678
MT5_SERVER=YourBroker-Server
MT5_PASSWORD=your_password

# ===========================================
# Database
# ===========================================
DATABASE_PATH=trading.db

# ===========================================
# Redis (Optional - for multi-process IPC)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/statarb.log
