# ============================================================
# StatArb Pro - Configuration File
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file and name it ".env" (just ".env", no extension)
# 2. Fill in your MT5 settings below
# 3. Save the file
# 4. Double-click run.bat to start
# ============================================================

# ============================================================
# MT5 Configuration (Required for MT5 Trading)
# ============================================================
# Get these from your MT5 broker

# Path to your MT5 terminal (usually one of these):
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_PATH=C:\Program Files (x86)\MetaTrader 5\terminal64.exe
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Your MT5 account number (the number you use to login)
MT5_ACCOUNT=12345678

# Your broker's server name (shown in MT5 login screen)
MT5_SERVER=YourBroker-Server

# Your MT5 trading password (NOT the investor password)
MT5_PASSWORD=your_password

# ============================================================
# OKX Exchange Configuration (Optional - for crypto trading)
# ============================================================
# Leave as-is if you're only testing MT5
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_SIMULATED=true

# ============================================================
# Application Settings (No changes needed)
# ============================================================
DATABASE_PATH=trading.db
LOG_LEVEL=INFO
LOG_FILE=logs/statarb.log
