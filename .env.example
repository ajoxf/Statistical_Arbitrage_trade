# Copy to .env (gitignored) and fill in. Never put passwords in config.json or code.
# The password_env field in config.json names which variable to read.
MT5_PASSWORD_A=your-account-a-password
MT5_PASSWORD_B=your-account-b-password

# Telegram notifications (optional). Create a bot via @BotFather.
# Leave blank to disable. Chat ID auto-registers when you send /start
# to the bot, but setting it here is more reliable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
